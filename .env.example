# Spotify Web API (Werte aus dem Spotify Developer Dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
SESSION_SECRET=musiclens-dev-secret
PORT=3000

# Dienste. In Docker setzt Compose die internen Adressen selbst.
STATS_SERVICE_URL=http://127.0.0.1:8001
RECOMMENDATION_SERVICE_URL=http://127.0.0.1:8002
DATABASE_URL=postgresql://musiclens:musiclens@127.0.0.1:5432/musiclens
RABBITMQ_URL=amqp://musiclens:musiclens@127.0.0.1:5672/
RABBITMQ_USER=musiclens
RABBITMQ_PASSWORD=musiclens
POSTGRES_USER=musiclens
POSTGRES_PASSWORD=musiclens
POSTGRES_DB=musiclens
